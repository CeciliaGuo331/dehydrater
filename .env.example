# ============================================================================
# dehydrater 环境配置示例
#
# 用法：复制为 .env，填写各项 API Key，按需修改地址和模型：
#
#     cp .env.example .env
#
# 也可以运行 `dehydrater setup` 交互式填写，它会帮你写入 shell 启动文件
# 或 ~/.config/dehydrater/env，效果与本文件相同。
#
# ---- 配置从哪里读取 ----
# 每一项按以下顺序查找，先找到的生效：
#   1. 环境变量（例如在 ~/.zshrc 中 export 的）
#   2. 当前目录向上找到的第一个 .env 文件（即本文件复制出来的那个）
#   3. ~/.config/dehydrater/env（`dehydrater setup` 可写入；Windows 与 macOS 路径不同，
#      setup 会显示实际位置）
#   4. 内置默认值：只有地址和模型有默认值，API Key 必须填写
# 值留空等同于未设置，会继续往下查找。
#
# ---- 变量命名 ----
#   DEHYDRATER_<任务>_URL     接入地址
#   DEHYDRATER_<任务>_MODEL   模型（语音识别为资源 ID）
#   DEHYDRATER_<任务>_KEY     API Key
# 任务共四个，见下文。每个任务单独配置，可以来自不同的服务或账号；
# 想共用一把 Key，就在几个任务里填同一个值。
#
# ---- 检查 ----
#   dehydrater check    检查是否都已设置，并逐项测试能否连通
#
# 注意：.env 中是明文密钥，已在 .gitignore 中，切勿提交到仓库或分享给他人。
# ============================================================================


# ---------------------------------------------------------------------------
# 任务 1：录音文件识别（transcribe）
# 把课堂录音转成带时间戳的逐字稿 → raw.md
#
# 服务：火山引擎「豆包语音」→ 录音文件识别（标准版）
#   控制台：火山引擎控制台 → 豆包语音 → 录音文件识别，开通后在 API Key 管理中创建 Key
#   注意它与「火山方舟」是两个产品，Key 不通用
#
# 资源 ID：
#   volc.seedasr.auc   豆包录音文件识别模型 2.0（默认；0.8 元/小时）
#   volc.bigasr.auc    豆包录音文件识别模型 1.0（2.3 元/小时）
#   需要在控制台中开通对应的版本，否则会报 45000030 requested resource not granted
# ---------------------------------------------------------------------------
DEHYDRATER_TRANSCRIBE_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel
DEHYDRATER_TRANSCRIBE_MODEL=volc.seedasr.auc
DEHYDRATER_TRANSCRIBE_KEY=


# ---------------------------------------------------------------------------
# 以下三个任务都调用大语言模型，接口兼容 OpenAI Chat Completions，
# 因此也可以换成 DeepSeek、硅基流动、OpenRouter 等兼容服务：改 URL、MODEL、KEY 即可。
#
# 默认使用火山引擎「火山方舟」：
#   控制台：火山方舟 → 开通管理（开通要用的模型）→ API Key 管理（创建 Key）
#   MODEL 可以填模型 ID（如 doubao-seed-2-1-pro-260915），
#   也可以填你在方舟中创建的推理接入点 ID（形如 ep-20261012xxxxxx-xxxxx）
#   地址为方舟时，程序会自动关闭模型的"深度思考"：本项目的任务不需要，开着又慢又贵
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# 任务 2：逐字稿脱水（dehydrate）
# 把口语化的逐字稿精炼成书面文字 → dehydrated.md
# 分块并发调用，调用次数多但每次很短，适合用便宜、快速的模型
# ---------------------------------------------------------------------------
DEHYDRATER_DEHYDRATE_URL=https://ark.cn-beijing.volces.com/api/v3
DEHYDRATER_DEHYDRATE_MODEL=doubao-seed-2-1-lite-260915
DEHYDRATER_DEHYDRATE_KEY=


# ---------------------------------------------------------------------------
# 任务 3：笔记大纲（outline）
# 通读课件和脱水稿，把整节课分章、对应到课件页 → notes.md 的骨架
# 一次读入全部内容，需要较强的理解能力
# ---------------------------------------------------------------------------
DEHYDRATER_OUTLINE_URL=https://ark.cn-beijing.volces.com/api/v3
DEHYDRATER_OUTLINE_MODEL=doubao-seed-2-1-pro-260915
DEHYDRATER_OUTLINE_KEY=


# ---------------------------------------------------------------------------
# 任务 4：笔记撰写（write_notes）
# 按章撰写以课件为主线、融入课堂讲解的笔记 → notes.md 的正文
# 决定笔记质量，建议用较强的模型
# ---------------------------------------------------------------------------
DEHYDRATER_WRITE_NOTES_URL=https://ark.cn-beijing.volces.com/api/v3
DEHYDRATER_WRITE_NOTES_MODEL=doubao-seed-2-1-pro-260915
DEHYDRATER_WRITE_NOTES_KEY=
